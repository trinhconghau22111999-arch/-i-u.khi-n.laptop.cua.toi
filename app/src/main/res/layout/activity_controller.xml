<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout_code_entry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controller_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/controller_code_hint"
            android:inputType="number"
            android:maxLength="6" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_connect" />
    </LinearLayout>

    <!--
        Hiển thị màn hình của Máy B tại đây sau khi kết nối thành công.
    -->
    <FrameLayout
        android:id="@+id/remote_view_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nút ngắt kết nối nổi trên góc trên-phải -->
        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="Ngắt"
            android:alpha="0.75"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Nút bật/tắt bàn phím ảo — hữu ích khi bên bị điều khiển là laptop (Windows Agent),
             chuột (tap/swipe) vẫn dùng vùng video như bình thường, đây chỉ thêm khả năng gõ chữ. -->
        <Button
            android:id="@+id/btn_toggle_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="⌨"
            android:alpha="0.75"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Thanh bàn phím: gõ chữ + các phím đặc biệt thường dùng. Ẩn mặc định. -->
        <LinearLayout
            android:id="@+id/layout_keyboard_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#DD000000"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_remote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gõ để gửi từng ký tự sang máy bị điều khiển"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_key_tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tab" />

                <Button
                    android:id="@+id/btn_key_backspace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⌫" />

                <Button
                    android:id="@+id/btn_key_esc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Esc" />

                <Button
                    android:id="@+id/btn_key_enter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enter ⏎" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
